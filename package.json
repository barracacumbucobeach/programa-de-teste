{
  "name": "fluxia-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Fluxia Desktop — construtor visual de fluxos e motor de automação para WhatsApp, 100% local, sem custos de API ou nuvem.",
  "author": {
    "name": "Fluxia Desktop",
    "email": "contato@fluxia.local"
  },
  "main": "electron/main.js",
  "scripts": {
    "start:engine": "node src/backend/engine.js",
    "dev:frontend": "vite --config src/frontend/vite.config.js",
    "build:frontend": "vite build --config src/frontend/vite.config.js",
    "preview:frontend": "vite preview --config src/frontend/vite.config.js",
    "dev": "concurrently -k -n ENGINE,BUILDER -c blue,green \"npm:start:engine\" \"npm:dev:frontend\"",
    "icon": "node scripts/generate-icon.js",
    "electron:dev": "concurrently -k -n ENGINE,BUILDER,ELECTRON -c blue,green,magenta \"npm:start:engine\" \"npm:dev:frontend\" \"electron .\"",
    "electron:preview": "npm run build:frontend && electron .",
    "dist": "npm run build:frontend && electron-builder --publish never",
    "dist:linux": "npm run build:frontend && electron-builder --linux --publish never",
    "dist:win": "npm run build:frontend && electron-builder --win --publish never",
    "dist:mac": "npm run build:frontend && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.8",
    "@xyflow/react": "^12.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^32.2.6",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.fluxia.desktop",
    "productName": "Fluxia Desktop",
    "copyright": "Copyright © 2026 Fluxia Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/backend/**/*",
      "dist/**/*",
      "data/fluxo_builder.json",
      "data/fluxo_bot.json",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Network",
      "executableName": "fluxia-desktop"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "category": "public.app-category.business"
    }
  }
}
